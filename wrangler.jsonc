{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-site",
  "compatibility_date": "2026-06-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    // Site files at repo root. Exclude .git via committed .assetsignore
    // (without it, Workers uploads .git packs and hits the 25 MiB limit).
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
